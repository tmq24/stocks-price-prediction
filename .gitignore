#   data/news/eodhd_news_raw.csv          2.0 GB
#   data/news/eodhd_news_clean.csv        1.8 GB
#   data/news/per_ticker/*.csv            28 MB – 370 MB mỗi file
#   data/price/*.csv                      nhỏ nhưng exclude theo yêu cầu
data/

